# Deterministic offline demo; no model key is required.
YOUHUO_DB_PATH=data/youhuo.db
YOUHUO_DEMO_MODE=true

# Production: inject a long random secret and store it outside source control.
# YOUHUO_AUDIT_KEY=replace_with_a_random_secret

# Optional OpenAI-compatible model. Setting all three switches the main chat
# path into model-advised routing: the model proposes intent and slots, and the
# deterministic layer still owns risk, confirmation, approval and execution.
# A disagreement between the model and the keyword classifier produces a
# clarification question, never a guess. Leave these unset for the fully
# offline deterministic build; /health reports which mode is active.
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_me

# Optional offline neural voice (sherpa-onnx). Without it the elder client uses
# the browser's own speech synthesis; nothing else changes. Enable with:
#   pip install sherpa-onnx
#   curl -LO https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/vits-melo-tts-zh_en.tar.bz2
#   tar xf vits-melo-tts-zh_en.tar.bz2      # ~160MB, keep it out of the kit
# Synthesis runs entirely on this machine; no text is uploaded.
# Note: keep the path ASCII-only - the native FST reader cannot open files
# under a directory whose name contains non-ASCII characters on Windows.
# YOUHUO_TTS_MODEL_DIR=/opt/youhuo-tts/vits-melo-tts-zh_en
